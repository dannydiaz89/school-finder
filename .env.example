# Copy to .env.local. `npx convex dev` fills in the Convex values.
# With an address below the app reads that Convex deployment; with none it serves the
# sample data bundled with it, which needs no backend. To go back to sample data, blank
# NEXT_PUBLIC_CONVEX_URL.
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=

# Lets `pnpm run import` clear cached pages when it finishes. Any random string of 16+ characters.
REVALIDATE_SECRET=
# Where the app is running, for that call. Defaults to http://localhost:3000.
APP_URL=

# Containers only: the Convex address read when the server starts, instead of the
# NEXT_PUBLIC_ one above, which is fixed when the app is built.
CONVEX_URL=

# ---------------------------------------------------------------------------------------
# LOADING DATA ONTO A LIVE SITE
#
# Imports run from your machine and need to know where the live site is. Make a second
# copy of this file named .env.production.local (Git ignores it) and fill in:
#
#   CONVEX_DEPLOYMENT, NEXT_PUBLIC_CONVEX_URL   the deployment the live site reads
#   APP_URL                                     the live site's address
#   REVALIDATE_SECRET                           the same value the live site has
#
# Then, when the state publishes a new year:
#
#   pnpm run import history --years 2026 --dry-run                        (checks, writes nothing)
#   pnpm run import history --years 2026 --env .env.production.local      (loads it)
#
# The full routine, what to look for, and what it costs are in README.md under
# "Loading a new year on the live site". Read that before the second command.
# ---------------------------------------------------------------------------------------
