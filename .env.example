# Copy to .env.local. `npx convex dev` fills in the Convex values.
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
# fixtures | convex. Fixtures need no backend and are what the UI streams build against.
DATA_SOURCE=fixtures
# Lets `pnpm run import` clear cached pages when it finishes. Any random string of 16+ characters.
REVALIDATE_SECRET=
# Where the app is running, for that call. Defaults to http://localhost:3000.
APP_URL=
# Containers only: the Convex address read when the server starts, instead of the
# NEXT_PUBLIC_ one above, which is fixed when the app is built.
CONVEX_URL=
