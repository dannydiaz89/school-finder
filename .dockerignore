# Keep the build context small and keep secrets out of the image.
.git
.gitignore
node_modules
.next
out
build
coverage

# Local environment files hold deployment names and secrets. The container
# takes its settings at start instead.
.env*
!.env.example

# Source files downloaded for imports: large, and imports do not run in the image.
.cache

# Test output and tooling state.
test-results
playwright-report
blob-report
.vercel
.claude
*.tsbuildinfo
next-env.d.ts
.DS_Store

Dockerfile
compose.yaml
.dockerignore
